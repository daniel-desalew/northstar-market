PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Use a long random value (at least 32 characters) for JWT_SECRET.
# Optional email delivery through Resend. Leave blank to keep email disabled.
RESEND_API_KEY=
